# 1-Butanol-Water Rigorous Distillation

PROCESS: 1-Butanol-Water Distillation
VERSION: 1.0
ONLINE_LOOKUP: false
THERMO_METHOD: NRTL

COMPONENTS:
    butanol | 1-Butanol | MW=74.12
    water | Water | MW=18.02

STREAM Feed : FEED -> COL-1.feed
    T = 25 [C]
    P = 1 [bar]
    F = 100 [kmol/h]
    x = butanol:0.40, water:0.60

STREAM Distillate : COL-1.distillate -> PRODUCT
STREAM Bottoms : COL-1.bottoms -> PRODUCT

UNIT COL-1
    TYPE: RigorousDistillation
    PORTS:
        feed : inlet
        distillate : outlet
        bottoms : outlet
    PARAMS:
        N_stages = 20
        feed_stage = 10
        reflux_ratio = 1.2
        D_to_F = 0.65
        P_condenser = 1 [bar]
        P_drop_per_stage = 0 [bar]
        condenser_type = total
        initializer = auto
        stage_phase_model = VLLE
