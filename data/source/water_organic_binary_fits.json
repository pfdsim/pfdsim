{
  "schema_version": "1.0",
  "description": "Consolidated water + hydrophobic-solvent binary NRTL and UNIQUAC regressions for PFDSim.",
  "component_order_convention": {
    "component1": "Water",
    "component2": "Organic solvent",
    "nrtl_tau12": "interaction from component 1 (water) toward component 2 under PFDSim convention",
    "nrtl_tau21": "reverse interaction under PFDSim convention"
  },
  "model_forms": {
    "nrtl": {
      "Tref_K": 298.15,
      "equation": "tau_ij = c_ij + d_ij/T + e_ij*((Tref-T)/T + ln(T/Tref))",
      "alpha_default": 0.3,
      "complexity_policy": "Set e_ij to zero unless broad-temperature data and validation justify the additional curvature."
    },
    "uniquac": {
      "equation": "tau_ij = exp(a_ij + b_ij/T + c_ij*T)",
      "model_variant": "standard_uniquac",
      "use_q_prime": false,
      "complexity_policy": "Set c_ij to zero unless supported by temperature-dependent data and validation."
    }
  },
  "fit_philosophy": {
    "source_balanced": true,
    "notes": [
      "Dense evaluated/smoothed curves are treated as source-level information rather than allowing point count alone to dominate.",
      "Author-rejected, superseded, duplicate, or literature-derived non-independent points are excluded or downweighted.",
      "LLE residuals use composition-sensitive scaling appropriate for dilute branches.",
      "Where available, VLE/VLLE pressure, vapor composition, Henry/infinite-dilution data, and excess enthalpy are used for validation or moderate thermodynamic-derivative constraints.",
      "Extra temperature coefficients are retained only when they materially improve multi-source predictive performance without pathological parameter growth."
    ]
  },
