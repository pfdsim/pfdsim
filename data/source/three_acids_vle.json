  "schema_version": "1.0",
  "metadata": {
    "description": "Recommended acid-acid liquid activity parameters with vapor homo-dimerization fixed from pure-component parameters and vapor hetero-dimerization defaulting to statistical cross-association.",
    "fit_date": "2026-08-30",
    "gas_constant_J_mol_K": 8.314462618,
    "vapor_association_standard_state_kPa": 101.3,

    "fit_philosophy": {
      "description": "Pure-component vapor dimerization is fixed independently. Acid-acid heterodimerization defaults to the statistical cross rule. Binary VLE is used only to regress residual liquid nonideality. Vapor cross H/S and liquid activity parameters are not simultaneously regressed.",
      "statistical_cross_rule": "K_ij(T) = 2*sqrt(K_i(T)*K_j(T))",
      "pfdsim_cross_parameterization": "PFDSim stores residual heterodimer delta_H and delta_S relative to the statistical expectation. Blank or zero residual interaction therefore means statistical cross-association.",
      "preferred_regression_sequence": [
        "Fix pure-component homo-dimerization parameters.",
        "Set acid-acid vapor cross residual delta_H and delta_S to zero.",
        "Back-calculate residual liquid activity coefficients from VLE.",
        "Fit NRTL or UNIQUAC only to the residual liquid nonideality."
      ]
    },

    "vapor_association_model": {
      "homo_dimer_equilibrium": "K_i(T) = exp(delta_S_i/R - delta_H_i/(R*T))",
      "homo_dimer_pressure": "p_ii = K_i*p_i_m^2/P0",
      "hetero_dimer_default": "K_ij(T) = 2*sqrt(K_i*K_j)",
      "hetero_dimer_pressure": "p_ij = K_ij*p_i_m*p_j_m/P0",
      "pure_saturated_monomer_reference": "P_sat = p_m_sat + K_i*(p_m_sat^2)/P0",
      "vle_monomer_relation": "p_i_m = gamma_i*x_i*p_i_m_sat"
    },

