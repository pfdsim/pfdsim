# Ethanol-water liquid mixture through an inclined, smoothly expanding pipe.

PROCESS: Ethanol Water Inclined Pipe
VERSION: 1.0
ONLINE_LOOKUP: false
THERMO_METHOD: UNIFAC
DESCRIPTION: Velocity-sized stainless-steel pipe with a smooth outlet expansion

COMPONENTS:
    ethanol | Ethanol | MW=46.069
    water | Water | MW=18.015

PROPERTY_CORRELATIONS:
    ethanol.mul | equation=poly_tp, Tmin_K=298.00, Tmax_K=298.30, Pmin_bar=3.2, Pmax_bar=5.5, P_ref_bar=5.0, A=0.0010851050682761157, B=-0.002095621280392025, C=6.899872715653965e-7, D=0.0026077420743816772, E=-9.428777857103798e-7, F=-2.2873153349665942e-10, source="CoolProp narrow fit"
    water.mul | equation=poly_tp, Tmin_K=298.00, Tmax_K=298.30, Pmin_bar=3.2, Pmax_bar=5.5, P_ref_bar=5.0, A=0.00088996718447546, B=-0.0020268827298461035, C=-1.3805803723105844e-8, D=0.0037260244899847287, E=2.8061690337129967e-7, F=1.683424233345221e-11, source="CoolProp narrow fit"

STREAM Feed : FEED -> PIPE-100.in
    T = 25 [C]
    P = 5 [bar]
    F = 100 [kmol/h]
    x = ethanol:0.40, water:0.60

STREAM Product : PIPE-100.out -> PRODUCT

UNIT PIPE-100
    TYPE: Pipe
    PORTS:
        in  : inlet
        out : outlet
    PARAMS:
        length = 150 [m]
        velocity = 1.5 [m/s]
        diameter_out = 40 [mm]
        diameter_profile = smooth
        material = stainless_steel
        angle = 3 [deg]
        friction_model = churchill
        profile_points = 11
