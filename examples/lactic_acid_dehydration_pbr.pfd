#==============================================================================
# PROCESS FLOW DIAGRAM - L-Lactic Acid Dehydration and Primary Condensation
#==============================================================================
# Four simultaneous irreversible vapor-phase pathways are represented:
#
#   LLA   -> AA + H2O
#   LLA   -> AcH + CO + H2O
#   2 LLA -> PA + AcH + CO2 + H2O
#   2 LLA -> PD23 + CO2 + 2 H2O
#
# The fitted rates are reported on a lactic-acid-consumption basis in
# mmol_LA/(h*m2_catalyst). The K-ZSM-5 BET area converts them to the PBR's
# catalyst-mass basis:
#
#   1 mmol/(h*m2) * 208 m2/g = 0.208 kmol/(kg_cat*h)
#
# For the PA and PD23 pathways, one reaction extent consumes two LLA, so their
# catalyst-mass extent prefactors are 0.5*k_ref*0.208. All four extents are
# integrated simultaneously against the same local LLA and H2O partial
# pressures; selectivity is not imposed after conversion.
#
# The reported rates are treated as apparent catalyst rates. No additional
# pellet effectiveness factor is applied because no effective diffusivity was
# supplied and an extra correction could double-count transport already present
# in the measured BET-area-normalized rates.
#==============================================================================

PROCESS: L-Lactic Acid Dehydration and Primary Condensation
VERSION: 1.0
ONLINE_LOOKUP: false
THERMO_METHOD: UNIQUAC-VDM
RECYCLE_METHOD: BROYDEN
TEAR_STREAMS: Organic-Recycle, Aqueous-Recycle
RECYCLE_TRACE_TOLERANCE: 1e-8
THERMO_SCOPES:
    extraction | method=NRTL
DESCRIPTION: Jacketed vapor PBR followed by a 40 C aqueous product condenser

# UNIQUAC-VDM supplies the liquid activity model and acid vapor association.
# The hot dilute reactor result remains effectively identical to IDEAL, while
# the model also supports the strongly nonideal aqueous condenser downstream.
#
# Formation enthalpies are resolved through the normal offline property system.
# Conversion and selectivity are kinetic; the jacket heat balance uses the
# selected thermochemical provenance reported by the simulator.

COMPONENTS:
    LLA  | 79-33-4          | formula=C3H6O3, MW=90.078, SMILES=C[C@H](O)C(=O)O
    H2O  | Water            | formula=H2O, MW=18.015
    AA   | Acrylic Acid     | CAS=79-10-7, formula=C3H4O2, MW=72.063
    AcH  | Acetaldehyde     | CAS=75-07-0, formula=C2H4O, MW=44.053
    PA   | Propionic Acid   | CAS=79-09-4, formula=C3H6O2, MW=74.079
    PD23 | 600-14-6         | formula=C5H8O2, MW=100.117, SMILES=CCC(=O)C(=O)C
    CO   | Carbon Monoxide  | formula=CO, MW=28.010
    CO2  | Carbon Dioxide   | formula=CO2, MW=44.009
    MIBK | 108-10-1         | formula=C6H12O, MW=100.161

# No full water/2,3-pentanedione VLE dataset is available. This directional
# UNIQUAC interaction is anchored to measured PD23-in-water infinite-dilution
# activity coefficients of 172, 195, and 207 at 313.15, 318.15, and 323.15 K.
# The unmeasured water-in-PD23 direction retains the UNIFDMD infinite-dilution
# prediction. At the three measured temperatures, the anchored PD23 limits are
# 173.63, 191.22, and 209.10, within the reported 7-9% experimental RSD.
INTERACTION_PARAMETERS:
    H2O/PD23 | model=UNIQUAC, tau12_a=-3.89191887, tau12_b=1040.281856, tau12_c=0, tau21_a=2.40611711, tau21_b=-974.287676, tau21_c=0, model_variant=standard_uniquac, use_q_prime=false, comment=PD23-in-water infinite-dilution anchor; reverse direction retained from UNIFDMD

    # The 25 C water/propanoic-acid/MIBK constants are energy parameters, not
    # direct tau values, and are interpreted in the PFD's cal/mol convention.
    # The shared water/MIBK pair instead uses the acrylic-acid regression below
    # because acrylic acid dominates the concentrated extraction feed.
    H2O/PA   | model=NRTL, scope=extraction, alpha=0.1, a12=2105.30, a21=-1124.50, comment=25 C water-propanoic acid-MIBK extraction regression
    PA/MIBK  | model=NRTL, scope=extraction, alpha=0.1, a12=-1297.70, a21=2043.30, comment=25 C water-propanoic acid-MIBK extraction regression

    # Stability-constrained constant-tau NRTL parameters fitted against the
    # paper's raw ternary LLE data for water/acrylic acid/MIBK.
    H2O/AA   | model=NRTL, scope=extraction, alpha=0.8361, tau12_c=4.4560, tau21_c=1.8867, comment=stability-constrained constant-tau fit to raw water-acrylic acid-MIBK LLE data
    H2O/MIBK | model=NRTL, scope=extraction, alpha=0.3799, tau12_c=4.7575, tau21_c=2.6617, comment=stability-constrained constant-tau fit to raw water-acrylic acid-MIBK LLE data
    AA/MIBK  | model=NRTL, scope=extraction, alpha=-0.1383, tau12_c=-12.6725, tau21_c=2.0522, comment=stability-constrained constant-tau fit to raw water-acrylic acid-MIBK LLE data

# Explicit PFD and curated database interactions take priority. Remaining
# missing liquid binaries are fitted once from UNIFDMD during initialization
# and remain frozen for the complete reactor/condenser simulation.
INTERACTION_ESTIMATION:
    UNIQUAC | source=UNIFDMD, policy=missing_only, parameter_order=source, do_not_extrapolate=true, Tmin=293.15 [K], Tmax=423.15 [K]

# The centered Arrhenius expression is evaluated directly:
#
#   R = k_mass_ref * exp[-Ea/Rgas * (1/T - 1/Tref)]
#       * (P_LLA/P_LLA_ref)^alpha * (P_H2O/P_H2O_ref)^beta
#
# T is K, p[...] is kPa, and the resulting extent rate is kmol/(kg_cat*h).
REACTIONS:
    acrylic_path : LLA -> AA + H2O | type=custom, A=1, Ea=0, Ea_unit=J/mol, rate_basis=pressure, concentration_unit=kmol/m3, pressure_unit=kPa, rate_unit=kmol/kg_cat/h, param_k_mass_ref=0.0644592, param_Ea=152300, param_Tref=633.15, param_PLAref=7.4, param_PH2Oref=66.9, param_alpha=0.212, param_beta=0.356, expression=k_mass_ref*exp(-(Ea/R)*(1/T-1/Tref))*(p['LLA']/PLAref)**alpha*(p['H2O']/PH2Oref)**beta
    acetaldehyde_path : LLA -> AcH + CO + H2O | type=custom, A=1, Ea=0, Ea_unit=J/mol, rate_basis=pressure, concentration_unit=kmol/m3, pressure_unit=kPa, rate_unit=kmol/kg_cat/h, param_k_mass_ref=0.01380704, param_Ea=185800, param_Tref=633.15, param_PLAref=7.4, param_PH2Oref=66.9, param_alpha=0.496, param_beta=1.125, expression=k_mass_ref*exp(-(Ea/R)*(1/T-1/Tref))*(p['LLA']/PLAref)**alpha*(p['H2O']/PH2Oref)**beta
    propionic_path : 2 LLA -> PA + AcH + CO2 + H2O | type=custom, A=1, Ea=0, Ea_unit=J/mol, rate_basis=pressure, concentration_unit=kmol/m3, pressure_unit=kPa, rate_unit=kmol/kg_cat/h, param_k_mass_ref=0.0020904, param_Ea=96900, param_Tref=633.15, param_PLAref=7.4, param_PH2Oref=66.9, param_alpha=1.116, param_beta=-0.124, expression=k_mass_ref*exp(-(Ea/R)*(1/T-1/Tref))*(p['LLA']/PLAref)**alpha*(p['H2O']/PH2Oref)**beta
    pentanedione_path : 2 LLA -> PD23 + CO2 + 2 H2O | type=custom, A=1, Ea=0, Ea_unit=J/mol, rate_basis=pressure, concentration_unit=kmol/m3, pressure_unit=kPa, rate_unit=kmol/kg_cat/h, param_k_mass_ref=0.000514904, param_Ea=225500, param_Tref=633.15, param_PLAref=7.4, param_PH2Oref=66.9, param_alpha=1.213, param_beta=0.370, expression=k_mass_ref*exp(-(Ea/R)*(1/T-1/Tref))*(p['LLA']/PLAref)**alpha*(p['H2O']/PH2Oref)**beta

# At the inlet, P_LLA=15.19875 kPa and P_H2O=86.12625 kPa. These differ from
# the kinetic reference pressures because the requested feed is 15 mol% LLA.
STREAM Wet-Lactic-Feed : FEED -> R-101.in
    T = 360 [C]
    P = 1.01325 [bar]
    F_mass = 5000 [kg/h]
    x = LLA:0.15, H2O:0.85

STREAM Reactor-Effluent : R-101.out -> E-201.in
STREAM Cooled-Effluent : E-201.out -> F-201.feed
STREAM Condenser-Vent : F-201.gas
STREAM Condensed-Product : F-201.liquid -> C-201.feed
STREAM Column-Overhead : C-201.distillate
STREAM Column-Bottoms : C-201.bottoms -> P-301.in
STREAM Pressurized-Concentrate : P-301.out -> E-301.in
STREAM Extraction-Feed : E-301.out -> X-301.feed
STREAM Fresh-MIBK : FEED -> M-301.mibk
    T = 25 [C]
    P = 1.01325 [bar]
    F_mass = 68.657533 [kg/h]
    w = MIBK:1.0

STREAM Solvent-Water-Makeup : FEED -> M-301.water
    T = 25 [C]
    P = 1.01325 [bar]
    F_mass = 1.631463 [kg/h]
    w = H2O:1.0

STREAM Organic-Recycle : D-401.light -> P-302.in
    T = 25 [C]
    P = 0.16 [bar]
    F = 27.1 [kmol/h]
    x = H2O:0.1166, MIBK:0.8834
STREAM Pressurized-Organic-Recycle : P-302.out -> M-301.organic
STREAM Extraction-Solvent : M-301.out -> X-301.solvent
STREAM Extraction-Raffinate : X-301.raffinate
STREAM Extraction-Extract : X-301.extract -> M-401.extract

STREAM Aqueous-Recycle : S-401.recycle -> P-401.in
    T = 25 [C]
    P = 0.16 [bar]
    F = 8.8 [kmol/h]
    x = H2O:0.9967, MIBK:0.0033
STREAM Aqueous-Purge : S-401.purge
STREAM Pressurized-Aqueous-Recycle : P-401.out -> M-401.water
STREAM Water-Assisted-Extract : M-401.out -> V-401.in
STREAM Vacuum-Column-Feed : V-401.out -> C-401.feed
STREAM Recovered-Azeotrope-Hot : C-401.distillate -> E-401.in
STREAM Acid-Product : C-401.bottoms
STREAM Recovered-Azeotrope-Cold : E-401.out -> D-401.in
STREAM Aqueous-Decanter : D-401.heavy -> S-401.in

# Supplied catalyst properties and preliminary bed assumptions:
#   catalyst particle density = 1050 kg/m3
#   particle diameter         = 0.6 mm
#   bed void fraction         = 0.40 (preliminary assumption)
#
# The PBR requires catalyst mass per total packed-bed volume, so:
#
#   bulk catalyst density = (1 - 0.40)*1050 = 630 kg/m3
#
# The 5000 kg/h feed is 173.46 kmol/h at the specified composition. The
# jacketed design uses 550 kg catalyst and about 114.4 million m2 of BET area.
# A 1536-tube, 0.05 m-ID assembly provides about 3.016 m2 total flow area,
# 0.8730 m3 packed volume, 69.84 m2 tube-wall area, and a derived packed depth
# near 0.2895 m. With U=50 W/(m2*K), UA is about 3.49 kW/K. A constant 470 C
# jacket is a preliminary mean-temperature representation of a circulating
# high-temperature molten-salt loop.
UNIT R-101 : PackedBedReactor
    catalyst_mass = 550 [kg]
    bulk_catalyst_density = 630 [kg/m3]
    bed_void_fraction = 0.40
    diameter = 0.05 [m]
    n_tubes = 1536
    particle_diameter = 0.6 [mm]
    phase = vapor
    mode = jacketed
    U = 50 [W/m2/K]
    T_jacket = 470 [C]
    pressure_drop_model = ergun
    kinetic_basis = apparent
    profile_points = 21
    solver = auto
    REACTIONS:
        @acrylic_path
        @acetaldehyde_path
        @propionic_path
        @pentanedione_path

# Primary condensation is performed by a 40 C cooler, followed by an adiabatic
# equilibrium separator at the inherited cooler-outlet pressure. CO and CO2
# use explicit pure-water Henry standard states in both units. This remains
# provisional because the solved condensate is about 87.4 mol% water, below
# the model's nominal 95 mol% pure-water cutoff. Acetaldehyde/water uses the
# curated apparent experimental UNIQUAC regression, while missing acetaldehyde
# cross-pairs use the frozen UNIFDMD-derived estimates declared above.
UNIT E-201 : Cooler
    T = 40 [C]
    henry_components = CO,CO2

UNIT F-201 : Flash
    Q = 0 [kW]
    henry_components = CO,CO2

# Preliminary water/light-ends removal probe. The partial condenser allows the
# trace CO and CO2 remaining after F-201 to leave with the vapor distillate.
# Column pressure defaults to the condensed-product feed pressure.
UNIT C-201 : RigorousDistillation
    N_stages = 15
    feed_stage = 8
    reflux_ratio = 1.0
    D_to_F = 0.03
    P_drop_per_stage = 0
    condenser_type = partial
    initializer = cheap_estimate

# The concentrated aqueous acid product is raised to atmospheric pressure and
# cooled to room temperature. The extractor is supplied with 2525 kg/h wet
# MIBK from the overhead-decanter organic recycle plus small MIBK and water
# makeup streams. Its isolated NRTL scope keeps the LLE regressions from
# altering the upstream and recovery-column UNIQUAC-VDM calculations.
UNIT P-301 : Pump
    P_out = 1.01325 [bar]

UNIT E-301 : Cooler
    T = 25 [C]

UNIT P-302 : Pump
    P_out = 1.01325 [bar]

UNIT M-301 : Mixer
    mode = adiabatic

UNIT X-301 : RigorousLiquidLiquidExtractor
    N_stages = 20
    mode = adiabatic
    T = 25 [C]
    solver_algorithm = equation_oriented
    thermo_scope = extraction

# Recycle 27.5058% of the water-rich decanter layer to balance essentially all
# MIBK at the fitted 0.16-bar heteroazeotrope (59.3037 mol% water, 40.6963 mol%
# MIBK). Pumping the aqueous recycle before mixing keeps the recovery feed at
# atmospheric pressure until its isenthalpic letdown to the vacuum column.
UNIT P-401 : Pump
    P_out = 1.01325 [bar]

UNIT M-401 : Mixer
    mode = adiabatic

UNIT V-401 : Valve
    P_out = 0.16 [bar]

# Vacuum solvent-recovery column. The cut removes 99.95% of the balanced
# water/MIBK carrier as heteroazeotrope while retaining virtually all AA and
# PA. Adaptive topology relabeling contracts the VLLE region toward the top.
UNIT C-401 : RigorousDistillation
    N_stages = 20
    feed_stage = 10
    reflux_ratio = 0.5
    D_to_F = 0.7405235022673647
    P_condenser = 0.16 [bar]
    P_drop_per_stage = 0
    condenser_type = total
    stage_phase_model = VLLE
    vlle_seed = cheap
    mesh_tolerance = 1e-5
    acceptable_mesh_residual = 1e-4
    max_iterations = 180
    max_jacobian_evaluations = 180

# Cool the heterogeneous azeotrope to room temperature. The MIBK-rich light
# layer returns to extraction; 27.5058% of the water-rich heavy layer supplies
# the recovery-column water demand and the remainder is purged.
UNIT E-401 : Cooler
    T = 25 [C]

UNIT D-401 : Decanter
    T = 25 [C]
    P = 0.16 [bar]
    lle_tolerance = 1e-9
    max_iter = 300

UNIT S-401 : Splitter
    outlets = recycle, purge
    recycle_split_frac = 0.27505834043469474
