PROCESS: Room Air 3A Molecular Sieve Drying
VERSION: 1.0
ONLINE_LOOKUP: false
DESCRIPTION: Pseudo-continuous 3A molecular sieve drying of 1000 kg/h room air at 25 C and 60% relative humidity using 75 kg/h regenerated sieve.
THERMO_METHOD: PR

COMPONENTS:
    water | Water    | MW=18.01528
    N2    | Nitrogen | MW=28.0134
    O2    | Oxygen   | MW=31.9988

STREAM Humid-Air : FEED -> MS-300.feed
    T = 25 [C]
    P = 1.01325 [bar]
    F = 34.90742209252892 [kmol/h]
    x = water:0.01874759437453738, N2:0.7751894004441154, O2:0.20606300518134713

STREAM Dry-Air : MS-300.product -> PRODUCT
STREAM Adsorbed-Water : MS-300.adsorbate -> PRODUCT

UNIT MS-300
    TYPE: MolecularSieveDryer
    PORTS:
        feed      : inlet
        product   : outlet
        adsorbate : outlet
    PARAMS:
        sieve_type = 3A
        adsorbent_mass_flow = 75 [kg/h]

# Expected behavior:
# - The feed water mole fraction corresponds to 60% RH at 25 C.
# - Product air is dried below 1% RH on this pseudo-continuous sieve basis.
