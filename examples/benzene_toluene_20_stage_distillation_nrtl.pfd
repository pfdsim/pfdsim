# Benzene-Toluene 20-Stage Distillation with NRTL

PROCESS: Benzene-Toluene 20-Stage Distillation
VERSION: 1.0
ONLINE_LOOKUP: false
DESCRIPTION: NRTL rigorous distillation of a benzene-toluene feed at 1 atm using 20 stages, feed stage 8, reflux ratio 1.5, and D/F 0.42
THERMO_METHOD: NRTL

COMPONENTS:
    C6H6 | Benzene | MW=78.11
    C7H8 | Toluene | MW=92.14

STREAM Feed : FEED -> COL-1.feed
    T = 25 [C]
    P = 1 [atm]
    F = 10 [kmol/h]
    x = C6H6:0.40, C7H8:0.60

STREAM Distillate : COL-1.distillate -> PRODUCT
STREAM Bottoms : COL-1.bottoms -> PRODUCT

UNIT COL-1
    TYPE: RigorousDistillation
    PORTS:
        feed : inlet
        distillate : outlet
        bottoms : outlet
    PARAMS:
        N_stages = 20
        feed_stage = 8
        reflux_ratio = 1.5
        D_to_F = 0.42
        P_condenser = 1 [atm]
        P_drop_per_stage = 0 [bar]
        condenser_type = total
        initializer = auto
        mesh_tolerance = 1e-7
        max_iterations = 180
