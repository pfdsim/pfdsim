#==============================================================================
# PROCESS FLOW DIAGRAM - Ethylene Oxide Production (Simplified)
#==============================================================================

PROCESS: Ethylene Oxide Production (Simplified)
VERSION: 1.0
THERMO_METHOD: NRTL-PR
ONLINE_LOOKUP: false
DESCRIPTION: Direct oxidation of ethylene to ethylene oxide (no recycle)

#------------------------------------------------------------------------------
# COMPONENTS
#------------------------------------------------------------------------------
COMPONENTS:
    C2H4   | Ethylene       | MW=28.05
    O2     | Oxygen         | MW=32.00
    C2H4O  | Ethylene Oxide | MW=44.05
    CO2    | Carbon Dioxide | MW=44.01
    H2O    | Water          | MW=18.02
    N2     | Nitrogen       | MW=28.01

#------------------------------------------------------------------------------
# STREAMS
#------------------------------------------------------------------------------
STREAM Ethylene-Feed : FEED -> MIX-1.in1
    T = 25 [C]
    P = 20 [bar]
    F = 100 [kmol/h]
    x = C2H4:0.99, N2:0.01

STREAM Oxygen-Feed : FEED -> MIX-1.in2
    T = 25 [C]
    P = 20 [bar]
    F = 70 [kmol/h]
    x = O2:1.0

STREAM S1 : MIX-1.out -> HEAT-1.in

STREAM S2 : HEAT-1.out -> R-1.in

STREAM S3 : R-1.out -> COOL-1.in

STREAM S4 : COOL-1.out -> SEP-1.in

STREAM Off-Gas : SEP-1.vap -> PRODUCT

STREAM S5 : SEP-1.liq -> DIST-1.feed

STREAM EO-Product : DIST-1.distillate -> PRODUCT

STREAM Bottoms : DIST-1.bottoms -> PRODUCT

#------------------------------------------------------------------------------
# UNITS
#------------------------------------------------------------------------------
UNIT MIX-1
    TYPE: Mixer
    PORTS:
        in1 : inlet
        in2 : inlet
        out : outlet
    PARAMS:
        mode = adiabatic

UNIT HEAT-1
    TYPE: Heater
    PORTS:
        in  : inlet
        out : outlet
    PARAMS:
        T_out = 250 [C]

UNIT R-1
    TYPE: Reactor
    PORTS:
        in  : inlet
        out : outlet
    PARAMS:
        T = 270 [C]
        P_drop = 0.5 [bar]
    REACTIONS:
        C2H4 + 0.5 O2 -> C2H4O | conversion=0.70, basis=C2H4
        C2H4 + 3 O2 -> 2 CO2 + 2 H2O | conversion=0.10, basis=C2H4

UNIT COOL-1
    TYPE: Cooler
    PORTS:
        in  : inlet
        out : outlet
    PARAMS:
        T_out = 40 [C]

UNIT SEP-1
    TYPE: Flash
    PORTS:
        in  : inlet
        vap : vapor_outlet
        liq : liquid_outlet
    PARAMS:
        T = 40 [C]
        P = 5 [bar]

UNIT DIST-1
    TYPE: ShortcutDistillation
    PORTS:
        feed       : inlet
        distillate : outlet
        bottoms    : outlet
    PARAMS:
        N_stages = 25
        reflux_ratio = 3.5
        P_top = 2 [bar]
        condenser_type = partial
        light_key = C2H4O
        heavy_key = H2O

#------------------------------------------------------------------------------
# END OF FILE
#------------------------------------------------------------------------------
