# Smooth concentric double-pipe exchanger, fully developed turbulent liquids.
# Outer annulus wall is insulated. Pressure losses are explicitly specified.
PROCESS: Double Pipe Calculated U
VERSION: 1.0
ONLINE_LOOKUP: false
THERMO_METHOD: IDEAL

COMPONENTS:
    water | Water | MW=18.015

STREAM HotWater : FEED -> HX-100.tube_in
    T = 86.85 [C]
    P = 3 [bar]
    F = 200 [kmol/h]
    x = water:1

STREAM ColdWater : FEED -> HX-100.shell_in
    T = 26.85 [C]
    P = 3 [bar]
    F = 300 [kmol/h]
    x = water:1

STREAM CooledWater : HX-100.tube_out -> PRODUCT
STREAM HeatedWater : HX-100.shell_out -> PRODUCT

UNIT HX-100
    TYPE: HeatExchanger
    PORTS:
        tube_in : inlet
        shell_in : inlet
        tube_out : outlet
        shell_out : outlet
    PARAMS:
        U_model = double_pipe_gnielinski
        tube_inner_diameter = 20 [mm]
        tube_outer_diameter = 24 [mm]
        shell_inner_diameter = 40 [mm]
        wall_conductivity = 16 [W/m/K]
        fouling_tube = 0.0001 [m2-K/W]
        fouling_shell = 0.0002 [m2-K/W]
        length = 8 [m]
        flow_pattern = countercurrent
        curve_segments = 40
