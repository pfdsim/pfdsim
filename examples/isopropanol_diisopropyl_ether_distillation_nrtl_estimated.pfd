# Isopropanol-Diisopropyl Ether Distillation with UNIFDMD-Estimated NRTL

PROCESS: Isopropanol-Diisopropyl Ether Distillation
VERSION: 1.0
ONLINE_LOOKUP: false
DESCRIPTION: Twenty-stage NRTL rigorous distillation of 20 mol% diisopropyl ether in isopropanol; the missing binary interaction is fitted once from UNIFDMD and frozen
THERMO_METHOD: NRTL

COMPONENTS:
    IPA | 67-63-0 | MW=60.095
    DIPE | 108-20-3 | MW=102.175

INTERACTION_ESTIMATION:
    NRTL | source=UNIFDMD, policy=always, parameter_order=source, alpha=0.3, Tmin=293.15 [K], Tmax=423.15 [K]

STREAM Feed : FEED -> COL-1.feed
    T = 25 [C]
    P = 1 [atm]
    F = 100 [kmol/h]
    x = IPA:0.80, DIPE:0.20

STREAM Distillate : COL-1.distillate -> PRODUCT
STREAM Bottoms : COL-1.bottoms -> PRODUCT

UNIT COL-1
    TYPE: RigorousDistillation
    PORTS:
        feed : inlet
        distillate : outlet
        bottoms : outlet
    PARAMS:
        N_stages = 20
        feed_stage = 10
        reflux_ratio = 1.2
        D_to_F = 0.25
        P_condenser = 1 [atm]
        P_drop_per_stage = 0 [bar]
        condenser_type = total
        initializer = auto
        mesh_tolerance = 1e-7
        max_iterations = 220
