PROCESS: Ethanol water flash with RKSMHV2
VERSION: 1.0
ONLINE_LOOKUP: false
THERMO_METHOD: RKSMHV2

COMPONENTS:
    ETOH | Ethanol
    H2O | Water

STREAM Feed : FEED -> FLASH-1.in
    T = 355 [K]
    P = 1 [bar]
    F = 100 [kmol/h]
    x = ETOH:0.5, H2O:0.5
STREAM Vapor : FLASH-1.vap -> PRODUCT
STREAM Liquid : FLASH-1.liq -> PRODUCT

UNIT FLASH-1 : Flash
    T = 355 [K]
    P = 1 [bar]
