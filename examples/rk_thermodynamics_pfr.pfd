#==============================================================================
# PROCESS FLOW DIAGRAM - Kinetics Reactor Test with RK Thermo
#==============================================================================

PROCESS: Methanol Decomposition Test
VERSION: 1.0
ONLINE_LOOKUP: false
THERMO_METHOD: RK
DESCRIPTION: PFR with power-law kinetics using RK thermodynamics

#------------------------------------------------------------------------------
# COMPONENTS
#------------------------------------------------------------------------------
COMPONENTS:
    CH3OH | Methanol | MW=32.04, Tc=512.6, Pc=80.9, omega=0.566, Hf=-201
    CO    | Carbon Monoxide | MW=28.01, Tc=132.9, Pc=35.0, omega=0.049, Hf=-110.5
    H2    | Hydrogen | MW=2.016, Tc=33.2, Pc=13.0, omega=-0.22, Hf=0

#------------------------------------------------------------------------------
# STREAMS
#------------------------------------------------------------------------------
STREAM Feed : FEED -> PFR-1.in
    T = 400 [C]
    P = 10 [bar]
    F = 100 [kmol/h]
    x = CH3OH:1.0

STREAM Product : PFR-1.out -> PRODUCT

#------------------------------------------------------------------------------
# UNITS
#------------------------------------------------------------------------------
UNIT PFR-1
    TYPE: PFR
    PORTS:
        in  : inlet
        out : outlet
    PARAMS:
        volume = 2 [m3]
        diameter = 0.3 [m]
        mode = adiabatic
        phase = vapor
        profile_points = 11
    REACTIONS:
        CH3OH -> CO + 2 H2 | A=2e12, Ea=120000, Ea_unit=J/mol, rate_basis=concentration, concentration_unit=kmol/m3, pressure_unit=bar, rate_unit=kmol/m3/h

#------------------------------------------------------------------------------
# END OF FILE
#------------------------------------------------------------------------------
