PROCESS: Ethanol Recovery by Partial Condensation and Water Absorption
VERSION: 1.0
ONLINE_LOOKUP: false
DESCRIPTION: A 75 C Henry-aware partial condensation removes most water and ethanol from a hot wet ethylene stream; a 10-stage adiabatic water absorber recovers the remaining ethanol while rejecting ether and ethylene.
THERMO_METHOD: UNIFNIST-RK

COMPONENTS:
    ethylene | Ethylene
    ethanol | Ethanol
    diethyl ether | Diethyl Ether
    water | Water

STREAM Hot-Wet-Feed : FEED -> FLASH-75.in
    T = 150 [C]
    P = 1.01325 [bar]
    F = 47.43226368669802 [kmol/h]
    x = ethylene:0.03382250709059489, ethanol:0.0961008504050113, diethyl ether:0.0005688800886797305, water:0.8695077624157141

STREAM Flash-Vapor : FLASH-75.vapor -> ABS-100.gas
STREAM Flash-Condensate : FLASH-75.liquid -> PRODUCT

STREAM Wash-Water : FEED -> ABS-100.water
    T = 25 [C]
    P = 1.01325 [bar]
    F = 24.978768047159914 [kmol/h]
    x = water:1.0

STREAM Recovered-Alcohol : ABS-100.liquid_out -> PRODUCT
STREAM Ethylene-Ether-Vent : ABS-100.gas_out -> PRODUCT

UNIT FLASH-75
    TYPE: Flash
    PORTS:
        in     : inlet
        vapor  : vapor_outlet
        liquid : liquid_outlet
    PARAMS:
        T = 75 [C]
        P = 1.01325 [bar]
        henry_components = ethylene

UNIT ABS-100
    TYPE: RigorousAbsorber
    PORTS:
        gas        : inlet
        water      : inlet
        gas_out    : vapor_outlet
        liquid_out : liquid_outlet
    PARAMS:
        N_stages = 10
        mode = adiabatic
        P_drop_per_stage = 0
        henry_components = ethylene
        T_min = 250 [K]
        T_max = 450 [K]
        max_iterations = 100

# Expected behavior:
# - The Henry-aware 75 C flash sends about 161.2 kg/h ethanol and 0.086 kg/h
#   ether to the condensate and leaves about 48.8 kg/h ethanol in its vapor.
# - The absorber captures about 99.3% of the remaining ethanol but only 1.7%
#   of the remaining ether; ethylene absorption is negligible.
# - Combining both liquid products recovers about 99.8% of the feed ethanol
#   while rejecting about 94.1% of the feed ether.
