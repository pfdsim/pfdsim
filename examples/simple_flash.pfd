#==============================================================================
# PROCESS FLOW DIAGRAM - Simple Flash Test
#==============================================================================

PROCESS: Simple Flash Separation
VERSION: 1.0
ONLINE_LOOKUP: false
DESCRIPTION: Simple flash test with ethanol-water

#------------------------------------------------------------------------------
# COMPONENTS
#------------------------------------------------------------------------------
COMPONENTS:
    H2O    | Water   | MW=18.02
    C2H5OH | Ethanol | MW=46.07

#------------------------------------------------------------------------------
# STREAMS
#------------------------------------------------------------------------------
STREAM Feed : FEED -> HEAT-1.in
    T = 25 [C]
    P = 1 [bar]
    F = 100 [kmol/h]
    x = H2O:0.6, C2H5OH:0.4

STREAM S1 : HEAT-1.out -> FLASH-1.in

STREAM Vapor : FLASH-1.vap -> PRODUCT

STREAM Liquid : FLASH-1.liq -> PRODUCT

#------------------------------------------------------------------------------
# UNITS
#------------------------------------------------------------------------------
UNIT HEAT-1
    TYPE: Heater
    PORTS:
        in  : inlet
        out : outlet
    PARAMS:
        T_out = 80 [C]

UNIT FLASH-1
    TYPE: Flash
    PORTS:
        in  : inlet
        vap : vapor_outlet
        liq : liquid_outlet
    PARAMS:
        T = 80 [C]
        P = 1 [bar]

#------------------------------------------------------------------------------
# END OF FILE
#------------------------------------------------------------------------------
